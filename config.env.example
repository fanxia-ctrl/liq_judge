# 强平 judge 调模型端点用的配置。复制成 config.env 再填，config.env 不进 git。环境变量同名时优先用环境变量。
JUDGE_BASE_URL=http://162.62.213.254:8000/v1
JUDGE_API_KEY=<模型端点的 key>
JUDGE_MODEL=glm-5.3
JUDGE_TIMEOUT=240
# 额外请求体，默认 {}。不要加 enable_thinking=false：这个部署会把推理漏进正文
JUDGE_EXTRA_BODY={}
# 只在本机 Mac 上需要：模型端点要走 VPN 隧道时填 auto（自动找 10.8.8.x 的 utun）或接口名。服务器上留空
JUDGE_IFACE=
